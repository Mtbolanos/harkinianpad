diff --git a/src/fast/backends/gfx_ios_display.mm b/src/fast/backends/gfx_ios_display.mm
new file mode 100644
index 00000000..66b564ee
--- /dev/null
+++ b/src/fast/backends/gfx_ios_display.mm
@@ -0,0 +1,32 @@
+#ifdef __IOS__
+#import <Foundation/Foundation.h>
+#import <UIKit/UIKit.h>
+
+// Refresh rate that Core Animation will actually deliver to this process.
+//
+// UIScreen.maximumFramesPerSecond reports what the panel can do (120 on ProMotion iPhones) even when
+// the system keeps the app at 60 Hz: iPhones only allow more than 60 Hz when the app's Info.plist sets
+// CADisableMinimumFrameDurationOnPhone, and Low Power Mode caps every app at 60 Hz. Pacing the game for
+// 120 Hz while presentation is held at 60 Hz makes each interpolated game tick take twice as long, which
+// shows up as the game running at half speed with very low effective frame rates.
+extern "C" int LUS_IOSEffectiveMaxRefreshRate(void) {
+    static int sPhoneHighRefreshAllowed = -1;
+    if (sPhoneHighRefreshAllowed < 0) {
+        BOOL allowed = YES;
+        if (UIDevice.currentDevice.userInterfaceIdiom == UIUserInterfaceIdiomPhone) {
+            id value = [NSBundle.mainBundle objectForInfoDictionaryKey:@"CADisableMinimumFrameDurationOnPhone"];
+            allowed = [value respondsToSelector:@selector(boolValue)] && [value boolValue];
+        }
+        sPhoneHighRefreshAllowed = allowed ? 1 : 0;
+    }
+
+    NSInteger panel = UIScreen.mainScreen.maximumFramesPerSecond;
+    if (panel <= 0) {
+        panel = 60;
+    }
+    if (!sPhoneHighRefreshAllowed || NSProcessInfo.processInfo.lowPowerModeEnabled) {
+        return (int)MIN(panel, (NSInteger)60);
+    }
+    return (int)panel;
+}
+#endif
